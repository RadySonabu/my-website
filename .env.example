# Gmail SMTP credentials for the contact form (app/api/contact/route.ts).
# GMAIL_APP_PASSWORD is a Google App Password, not the account password -
# generate one at https://myaccount.google.com/apppasswords (requires 2FA).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Cloudflare Turnstile keys for the contact form's bot challenge (free tier).
# Create a widget at https://dash.cloudflare.com/?to=/:account/turnstile
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is public and ships to the browser; leaving
# both unset disables Turnstile and falls back to the honeypot/time-trap only.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
